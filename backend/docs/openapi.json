        "description": "仅管理员可操作，直接以文本形式创建文档",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "content",
                  "categoryId"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "categoryId": {
                    "type": "string"
                  },
                  "originalName": {
                    "type": "string"
                  },
                  "fileType": {
                    "type": "string"
                  },
                  "fileSize": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "知识新增成功"
          },
          "400": {
            "description": "参数错误"
          },
          "403": {
            "description": "无权限"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
