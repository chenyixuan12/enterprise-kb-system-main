# Docker Compose 环境变量
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（必填）
LLM_API_KEY=your_api_key_here

# MongoDB 管理员账号（必填，上线前务必改成强密码）
# 注意：密码中不要包含 @ : / ? 等 URL 特殊字符，否则连接串会解析失败
MONGO_INITDB_ROOT_USERNAME=kbadmin
MONGO_INITDB_ROOT_PASSWORD=kbadmin123

# JWT 签名密钥（必填，请使用足够长的随机字符串，上线前务必修改）
JWT_SECRET=please_change_me_to_a_long_random_string
# Token 有效期，默认 7 天
JWT_EXPIRES_IN=7d

# Chroma 向量数据库（本地默认地址）
CHROMA_BASE_URL=http://127.0.0.1:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=enterprise_knowledge_chunks
CHROMA_TIMEOUT=30000

# 以下为可选配置，有默认值可省略
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# 本地 Ollama Embedding
# 先启动 Ollama，再拉取模型：
#   ollama pull bge-large-zh-v1.5
#   ollama serve
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=nomic-embed-text

DEFAULT_USER_PASSWORD=123456
